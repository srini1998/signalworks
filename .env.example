# Copy to .env and fill with generated values (e.g. `node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"`).
# Nothing here is a real credential; all services are local.
GRAFANA_ADMIN_PASSWORD=
EXPORTER_ADMIN_TOKEN=
SINK_READ_TOKEN=
SW_OWNER_PASSWORD=
SW_APP_PASSWORD=
SW_WORKER_PASSWORD=
SW_SESSION_SECRET=
# Written by `node --import tsx scripts/grafana-setup.ts` (dedicated Editor service account in the test Grafana):
GRAFANA_SA_TOKEN=
