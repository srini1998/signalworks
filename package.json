{
  "name": "signalworks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Observability Assurance Workbench (graf1) and FilterProof (graf2) - local only",
  "scripts": {
    "stack:up": "bash scripts/stack.sh up",
    "stack:down": "bash scripts/stack.sh down",
    "stack:status": "bash scripts/stack.sh status",
    "db:up": "bash scripts/db.sh",
    "migrate": "node --import tsx scripts/migrate.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "setup": "npm run stack:up && npm run db:up && npm run migrate && npm run seed && node --import tsx scripts/grafana-setup.ts",
    "dev": "node --import tsx server/index.ts",
    "worker": "node --import tsx worker/index.ts",
    "web:dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "browser": "node --import tsx scripts/browser-check.ts",
    "reset:runs": "node --import tsx scripts/reset-runs.ts"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
